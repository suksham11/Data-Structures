class Solution {
public:
    vector<int> queryResults(int limit, vector<vector<int>>& queries) {
      int n = queries.size();
      vector<int> result(n);
      unordered_map<int, int> ballmp , colormp;
      for(int i=0 ; i<n ; i++){
        int ball = queries[i][0], color = queries[i][1];  // Extract ball label and colo from query
        if(ballmp.find(ball) != ballmp.end()){             // Check if ball is already covered
            int prevcolor = ballmp[ball];              
            colormp[prevcolor]--;                        // Decrement count of the previous color on the ball
        
            if(colormp[prevcolor] == 0) colormp.erase(prevcolor);
        }
         // Set color of ball to the new color
        ballmp[ball] = color;
        // Increment the count of the new color
        colormp[color]++;
        result[i] = colormp.size();
      }
      return result;
    }
};
